# ── OpenAI (GPT-4o-mini for script generation) ─────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ── fal.ai (Flux Schnell image + Kling 1.6 video) ───────────────────────────
# Get your key at https://fal.ai/dashboard
FAL_KEY=your_fal_key_here

# ── IndicTrans2 translation server (self-hosted) ────────────────────────────
AI4BHARAT_BASE_URL=http://localhost:5000
AI4BHARAT_TRANSLATE_PATH=/translate
AI4BHARAT_API_KEY=

# ── Redis (ARQ job queue) ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Paths ────────────────────────────────────────────────────────────────────
STORAGE_DIR=storage

# ── Optional ─────────────────────────────────────────────────────────────────
# Hugging Face token (avoids rate limits when downloading Whisper models)
HF_TOKEN=
